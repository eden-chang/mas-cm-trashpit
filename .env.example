# Copy to .env and fill in real values. Never commit .env.

# --- Supabase (required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# --- Mastodon bot (required) ---
MASTODON_API_BASE_URL=https://your-instance.example
BOT_ACCESS_TOKEN=your_bot_access_token
# Comma-separated Mastodon account names allowed to run admin commands
SYSTEM_ADMIN_ID=admin1,admin2
# Fallback polling interval in seconds (used when streaming fails)
POLLING_INTERVAL=30

# --- Logging ---
LOG_LEVEL=INFO
DEBUG_MODE=False

# --- Flask API ---
FLASK_DEBUG=False
API_HOST=0.0.0.0
API_PORT=5000
# Comma-separated list of allowed origins
CORS_ORIGINS=*

# --- Access control (generate each with: openssl rand -hex 32) ---
# Shared by the bot and the API. Signs per-character inventory links.
INVENTORY_LINK_SECRET=
# Web app URL used in the links the bot sends
INVENTORY_WEB_URL=https://your-inventory.example
INVENTORY_LINK_TTL_DAYS=30
# Bearer token for /api/admin/*
ADMIN_API_TOKEN=

# --- Cache TTLs (seconds) ---
CACHE_TTL=60
CACHE_TTL_ITEMS=300
CACHE_TTL_CHARACTERS=30

# --- Opt-in tests that write to a real Supabase project ---
# ENABLE_BOT_SUPABASE_TESTS=true
# ENABLE_WRITE_TESTS=true
# TEST_API_BASE=http://localhost:5000
# TEST_CHARACTER=
# TEST_MASTODON_ID=
# TEST_ITEM=
# TEST_CHARACTER_RECEIVER=
