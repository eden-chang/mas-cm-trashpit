# ============================================================
# Supabase
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ============================================================
# Mastodon API
# ============================================================
MASTODON_API_BASE_URL=https://your-instance.example
BOT_ACCESS_TOKEN=your_bot_access_token

# 시스템 관리자 (콤마로 구분)
SYSTEM_ADMIN_ID=admin1,admin2

# ============================================================
# 로깅 설정
# ============================================================
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
ENABLE_CONSOLE_LOG=True

# ============================================================
# 봇–Supabase 통합 테스트 (tests/test_bot_supabase_connection.py)
# ============================================================
# ENABLE_BOT_SUPABASE_TESTS=true 로 설정 시 실제 Supabase에 반영되는 테스트 실행
# TEST_CHARACTER: characters 테이블에 존재하는 캐릭터 이름
# TEST_MASTODON_ID: 해당 캐릭터의 id 컬럼 값 (마스토돈 계정 ID)
# TEST_ITEM: items 테이블에 존재하는 아이템명
# TEST_CHARACTER_RECEIVER: (선택) 양도/지급 수신용 다른 캐릭터명
# ENABLE_BOT_SUPABASE_TESTS=true
# TEST_CHARACTER=
# TEST_MASTODON_ID=
# TEST_ITEM=
# TEST_CHARACTER_RECEIVER=

# ============================================================
# 기타 설정
# ============================================================
POLLING_INTERVAL=30
DEBUG_MODE=False

# ============================================================
# API (Phase 3)
# ============================================================
FLASK_DEBUG=False
API_HOST=0.0.0.0
API_PORT=5000
CORS_ORIGINS=*

# ============================================================
# 캐시 설정 (Phase 3.3)
# ============================================================
CACHE_TTL=60                    # 기본 TTL (초)
CACHE_TTL_ITEMS=300             # 아이템 캐시 (5분, 변경 적음)
CACHE_TTL_CHARACTERS=30         # 캐릭터 캐시 (30초, 변경 잦음)
FORTUNE_CACHE_ENABLED=True
